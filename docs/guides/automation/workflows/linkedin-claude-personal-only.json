        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-3-5-sonnet-20241022\",\n  \"max_tokens\": 1200,\n  \"temperature\": 0.7,\n  \"system\": \"Eres un experto en LinkedIn. Creas posts profesionales y atractivos.\",\n  \"messages\": [{\"role\": \"user\", \"content\": \"Crea un post profesional para LinkedIn sobre: {{ $json['formField:Tema del Post'] }}\\n\\nIncluye:\\n1. Hook inicial impactante\\n2. 3-5 insights valiosos\\n3. Párrafos cortos\\n4. 3-5 hashtags\\n5. Call-to-action\\n6. 150-300 palabras\\n7. Emojis profesionales\\n\\nDevuelve SOLO el post.\"}]\n}",
        "options": {}
      },
      "id": "claude-002",
      "name": "Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "claude-key",
          "name": "Claude API"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "post",
              "name": "post",
              "value": "={{ $json.content[0].text }}",
              "type": "string"
            }
          ]
        }
      },
      "id": "extract-003",
      "name": "Extraer",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [660, 300]
    },
    {
      "parameters": {
        "resource": "post",
        "text": "={{ $json.post }}",
        "additionalFields": {}
      },
      "id": "linkedin-004",
      "name": "LinkedIn Personal",
      "type": "n8n-nodes-base.linkedIn",
      "typeVersion": 1,
      "position": [880, 300],
      "credentials": {
        "linkedInOAuth2Api": {
          "id": "linkedin-personal",
          "name": "LinkedIn Personal"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "=✅ ¡Publicado!\n\n{{ $json.post }}\n\n━━━━━━━━━━━━━━━━\n\n🔗 Post ID: {{ $json.id }}\n\n👉 Revisa tu perfil de LinkedIn",
        "options": {}
      },
      "id": "confirm-005",
      "name": "OK",
