{
  "name": "LinkedIn Post Generator - OpenAI",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Create LinkedIn Post with AI",
        "formDescription": "Enter a post title and we'll generate professional LinkedIn content using OpenAI",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Post Title or Topic",
              "fieldType": "text",
              "requiredField": true
            }
          ]
        },
        "options": {
          "formSubmittedText": "Generating your post with AI..."
        }
      },
      "id": "form-trigger-node",
      "name": "Receive Post Title",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.1,
      "position": [240, 300],
      "webhookId": "linkedin-openai-form"
    },
    {
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": "gpt-4o-mini",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are an expert LinkedIn content strategist. Create engaging, professional LinkedIn posts that perform well and drive engagement."
            },
            {
              "role": "user",
              "content": "=Create a compelling LinkedIn post about: {{ $json['formField:Post Title or Topic'] }}\n\nRequirements:\n1. Start with a strong hook that grabs attention\n2. Provide valuable insights or tips (3-5 points)\n3. Use short paragraphs for readability\n4. Include 3-5 relevant hashtags\n5. End with an engaging call-to-action\n6. Keep it between 150-300 words\n7. Use emojis sparingly and professionally\n\nMake it authentic, valuable, and shareable."
            }
          ]
        },
        "options": {
          "temperature": 0.7,
          "maxTokens": 800
        }
      },
      "id": "openai-node",
      "name": "Generate with OpenAI",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.6,
      "position": [480, 300],
      "credentials": {
        "openAiApi": {
          "id": "openai-credentials",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "extract-content",
              "name": "postContent",
              "value": "={{ $json.message.content }}",
              "type": "string"
            }
          ]
        }
      },
      "id": "extract-node",
      "name": "Extract Post Content",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [700, 300]
    },
    {
      "parameters": {
        "resource": "post",
        "text": "={{ $json.postContent }}",
        "additionalFields": {}
      },
      "id": "linkedin-node",
      "name": "Post to LinkedIn",
      "type": "n8n-nodes-base.linkedIn",
      "typeVersion": 1,
      "position": [920, 300],
      "credentials": {
        "linkedInOAuth2Api": {
          "id": "linkedin-oauth",
          "name": "LinkedIn account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "=✅ Success! Your LinkedIn post has been published!\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n{{ $json.postContent }}\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n🔗 Post ID: {{ $json.id || 'Published successfully' }}\n\n👉 View it on your LinkedIn profile now!",
        "options": {}
      },
      "id": "confirm-node",
      "name": "Show Confirmation",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1140, 300]
    }
  ],
  "connections": {
    "Receive Post Title": {
      "main": [[{"node": "Generate with OpenAI", "type": "main", "index": 0}]]
    },
    "Generate with OpenAI": {
      "main": [[{"node": "Extract Post Content", "type": "main", "index": 0}]]
    },
    "Extract Post Content": {
      "main": [[{"node": "Post to LinkedIn", "type": "main", "index": 0}]]
    },
    "Post to LinkedIn": {
      "main": [[{"node": "Show Confirmation", "type": "main", "index": 0}]]
    }
  },
  "pinData": {},
  "settings": {"executionOrder": "v1"},
  "staticData": null,
  "tags": [],
  "triggerCount": 0,
  "updatedAt": "2025-10-24T00:00:00.000Z",
  "versionId": "openai-v1"
}
