{
  "name": "LinkedIn + Claude AI (Simple)",
  "nodes": [
    {
      "parameters": {
        "formTitle": "✨ Crear Post de LinkedIn con IA",
        "formDescription": "Ingresa el tema y Claude AI generará el contenido",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Tema del Post",
              "fieldType": "text",
              "requiredField": true,
              "placeholder": "Ej: Cómo la IA transforma el marketing"
            }
          ]
        },
        "options": {
          "formSubmittedText": "⏳ Generando tu post..."
        }
      },
      "id": "form-node-001",
      "name": "Formulario",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.1,
      "position": [220, 300],
      "webhookId": "post-linkedin-ai"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-3-5-sonnet-20241022\",\n  \"max_tokens\": 1200,\n  \"temperature\": 0.7,\n  \"system\": \"Eres un experto en crear posts profesionales para LinkedIn. Creas contenido atractivo, valioso y que genera engagement.\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Crea un post profesional para LinkedIn sobre: {{ $json['formField:Tema del Post'] }}\\n\\nRequisitos:\\n1. Hook inicial impactante (primeras 2 líneas)\\n2. 3-5 puntos de valor o insights\\n3. Párrafos cortos y espaciados\\n4. 3-5 hashtags relevantes\\n5. Call-to-action al final\\n6. 150-300 palabras\\n7. Emojis profesionales (5-8 total)\\n\\nDevuelve SOLO el post, sin comentarios adicionales.\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "claude-node-002",
      "name": "Claude AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "claude-header-auth",
          "name": "Claude API Key"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "post-content",
              "name": "postContent",
              "value": "={{ $json.content[0].text }}",
              "type": "string"
            }
          ]
        }
      },
      "id": "extract-node-003",
      "name": "Extraer Post",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [680, 300]
    },
    {
      "parameters": {
        "resource": "post",
        "text": "={{ $json.postContent }}",
        "additionalFields": {}
      },
      "id": "linkedin-node-004",
      "name": "LinkedIn",
      "type": "n8n-nodes-base.linkedIn",
      "typeVersion": 1,
      "position": [900, 300],
      "credentials": {
        "linkedInOAuth2Api": {
          "id": "linkedin-oauth",
          "name": "LinkedIn"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "=✅ ¡Post Publicado!\n\n━━━━━━━━━━━━━━━━━━━━━━━\n\n{{ $json.postContent }}\n\n━━━━━━━━━━━━━━━━━━━━━━━\n\n🔗 Post ID: {{ $json.id || 'OK' }}\n\n👉 Revisa tu LinkedIn!",
        "options": {}
      },
      "id": "confirm-node-005",
      "name": "Confirmación",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1120, 300]
    }
  ],
  "connections": {
    "Formulario": {
      "main": [[{"node": "Claude AI", "type": "main", "index": 0}]]
    },
    "Claude AI": {
      "main": [[{"node": "Extraer Post", "type": "main", "index": 0}]]
    },
    "Extraer Post": {
      "main": [[{"node": "LinkedIn", "type": "main", "index": 0}]]
    },
    "LinkedIn": {
      "main": [[{"node": "Confirmación", "type": "main", "index": 0}]]
    }
  },
  "pinData": {},
