{
  "name": "LinkedIn AI Content Generator",
  "nodes": [
    {
      "parameters": {
        "path": "linkedin-post",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Receive Post Title",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "You are a LinkedIn content expert. Create an engaging LinkedIn post based on this title: {{$json.postTitle}}\n\nRequirements:\n- Professional yet conversational tone\n- 150-200 words\n- Include relevant hashtags (3-5)\n- Add a call-to-action\n- Use line breaks for readability\n- Make it engaging and valuable to readers",
        "hasOutputParser": true
      },
      "id": "ai-agent",
      "name": "Generate AI Content",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "model": "gemini-pro",
        "options": {
          "temperature": 0.7,
          "maxOutputTokens": 500
        }
      },
      "id": "gemini-model",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [450, 450]
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "linkedin_automation"
      },
      "id": "memory",
      "name": "Chat Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1,
      "position": [450, 550]
    },
    {
      "parameters": {
        "schemaType": "fromJson",
        "jsonSchema": "{\n  \"postContent\": \"string\",\n  \"hashtags\": \"string\"\n}"
      },
      "id": "output-parser",
      "name": "Format AI Output",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1,
      "position": [600, 450]
    },
    {
      "parameters": {
        "resource": "post",
        "postAs": "person",
        "text": "={{$json.output}}"
      },
      "id": "linkedin-post",
      "name": "Post to LinkedIn",
      "type": "n8n-nodes-base.linkedIn",
      "typeVersion": 1,
      "position": [750, 300],
      "credentials": {
        "linkedInOAuth2Api": {
          "id": "YOUR_LINKEDIN_CREDENTIAL_ID",
          "name": "LinkedIn account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "✅ Success! Your post has been published to LinkedIn.\n\nPost content:\n{{$node[\"Generate AI Content\"].json[\"output\"]}}",
        "options": {}
      },
      "id": "confirmation",
      "name": "Show Confirmation",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [950, 300]
    }
  ],
