{
  "name": "LinkedIn Post Generator - Claude",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Create LinkedIn Post with Claude AI",
        "formDescription": "Enter a post title and we'll generate professional LinkedIn content using Claude",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Post Title or Topic",
              "fieldType": "text",
              "requiredField": true
            }
          ]
        },
        "options": {
          "formSubmittedText": "Claude is generating your post..."
        }
      },
      "id": "form-trigger-claude",
      "name": "Receive Post Title",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.1,
      "position": [240, 300],
      "webhookId": "linkedin-claude-form"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-3-5-sonnet-20241022\",\n  \"max_tokens\": 1024,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"You are an expert LinkedIn content strategist. Create a compelling LinkedIn post about: {{ $json['formField:Post Title or Topic'] }}\\n\\nRequirements:\\n1. Start with a strong hook that grabs attention\\n2. Provide valuable insights or tips (3-5 points)\\n3. Use short paragraphs for readability\\n4. Include 3-5 relevant hashtags\\n5. End with an engaging call-to-action\\n6. Keep it between 150-300 words\\n7. Use emojis sparingly and professionally\\n\\nMake it authentic, valuable, and shareable. Return ONLY the post content, no extra commentary.\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "claude-api-node",
      "name": "Generate with Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300],
      "credentials": {
        "anthropicApi": {
          "id": "claude-credentials",
          "name": "Claude (Anthropic) API"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "extract-claude-content",
              "name": "postContent",
              "value": "={{ $json.content[0].text }}",
              "type": "string"
            }
          ]
        }
      },
      "id": "extract-claude-node",
      "name": "Extract Post Content",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [700, 300]
    },
    {
      "parameters": {
        "resource": "post",
        "text": "={{ $json.postContent }}",
        "additionalFields": {}
      },
      "id": "linkedin-claude-node",
      "name": "Post to LinkedIn",
      "type": "n8n-nodes-base.linkedIn",
      "typeVersion": 1,
      "position": [920, 300],
      "credentials": {
        "linkedInOAuth2Api": {
          "id": "linkedin-oauth",
          "name": "LinkedIn account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "=✅ Success! Your LinkedIn post has been published!\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n{{ $json.postContent }}\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n🔗 Post ID: {{ $json.id || 'Published successfully' }}\n🤖 Generated with Claude AI\n\n👉 View it on your LinkedIn profile now!",
        "options": {}
      },
      "id": "confirm-claude-node",
      "name": "Show Confirmation",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1140, 300]
    }
  ],
  "connections": {
    "Receive Post Title": {
      "main": [[{"node": "Generate with Claude", "type": "main", "index": 0}]]
    },
    "Generate with Claude": {
      "main": [[{"node": "Extract Post Content", "type": "main", "index": 0}]]
    },
    "Extract Post Content": {
      "main": [[{"node": "Post to LinkedIn", "type": "main", "index": 0}]]
    },
    "Post to LinkedIn": {
      "main": [[{"node": "Show Confirmation", "type": "main", "index": 0}]]
    }
  },
  "pinData": {},
